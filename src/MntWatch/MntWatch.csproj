<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 ships with every Windows 10 and 11 install, so the .exe runs with nothing to install. -->
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>MntWatch</RootNamespace>
    <AssemblyName>MntWatch</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Version>1.0.0</Version>
    <Product>MntWatch</Product>
    <Description>Makes Linux file watchers in WSL 2 see changes to Windows folders under /mnt/c, so hot reload works again.</Description>
    <Copyright>Copyright (c) 2026 BoazCohenJ</Copyright>
    <Company>MntWatch</Company>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.ico" LogicalName="MntWatch.app.ico" />
    <EmbeddedResource Include="helper.sh" LogicalName="MntWatch.helper.sh" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MntWatch.Tests" />
  </ItemGroup>

</Project>
